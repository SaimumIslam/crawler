# All settings optional — sensible defaults apply.

# --- LLM extraction (extract.mode: llm) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5

# --- Proxies (strongly recommended for protected sites) ---
# Comma-separated list, or a single PROXY_URL. Use residential/rotating proxies.
# Format: scheme://user:pass@host:port  (scheme http/https/socks5)
PROXY_POOL=
PROXY_URL=

# --- Storage / paths ---
CRAWLER_DATA_DIR=data
CRAWLER_DB_PATH=
CRAWLER_EXPORT_DIR=
CRAWLER_SESSION_DIR=
CRAWLER_TEMPLATES_DIR=

# --- Logging ---
LOG_LEVEL=INFO
